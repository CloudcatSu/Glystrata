<Window x:Class="Glystrata.Views.SnapshotHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshot history"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="360"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="SnapshotList"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}" />
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button x:Name="DeleteAllButton" DockPanel.Dock="Left" Padding="14,6" Margin="5,0"
                    Foreground="{DynamicResource DiffRemovedForegroundBrush}" Click="DeleteAllButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CreateSnapshotButton" Padding="14,6" Margin="5,0" Click="CreateSnapshotButton_Click" />
                <Button x:Name="CompareButton" Padding="14,6" Margin="5,0" Click="CompareButton_Click" />
                <Button x:Name="RestoreButton" Padding="14,6" Margin="5,0" Click="RestoreButton_Click" />
                <Button x:Name="DeleteButton" Padding="14,6" Margin="5,0" Click="DeleteButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
