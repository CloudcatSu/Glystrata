<Window x:Class="Glystrata.Views.SnapshotHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snapshot history"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="360"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ListBox x:Name="SnapshotList"
                 Background="{DynamicResource SurfaceBrush}"
                 BorderBrush="{DynamicResource BorderBrush}"
                 Foreground="{DynamicResource PrimaryTextBrush}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CompareButton" Padding="14,6" Margin="5,0" Click="CompareButton_Click" />
            <Button x:Name="RestoreButton" Padding="14,6" Margin="5,0" Click="RestoreButton_Click" />
            <Button x:Name="DeleteButton" Padding="14,6" Margin="5,0" Click="DeleteButton_Click" />
            <Button x:Name="DeleteAllButton" Padding="14,6" Margin="5,0" Click="DeleteAllButton_Click" />
        </StackPanel>
    </Grid>
</Window>
