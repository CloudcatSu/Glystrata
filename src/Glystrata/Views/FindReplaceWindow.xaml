<Window x:Class="Glystrata.Views.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find and Replace"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        ShowInTaskbar="False">
    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FindLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBox x:Name="FindBox" Grid.Column="1"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     Padding="6,4" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ReplaceLabel" Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
            <TextBox x:Name="ReplaceBox" Grid.Column="1"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     Padding="6,4" />
        </Grid>
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,0,0,8"
                   MinHeight="18"
                   Foreground="{DynamicResource SecondaryTextBrush}" />
        <DockPanel Grid.Row="3">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="FindButton" Padding="12,5" Margin="0,0,5,0" Click="FindButton_Click" />
                <Button x:Name="PreviousButton" Padding="12,5" Margin="0,0,5,0" Click="PreviousButton_Click" />
                <Button x:Name="NextButton" Padding="12,5" Click="NextButton_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ReplaceButton" Padding="12,5" Margin="5,0,0,0" Click="ReplaceButton_Click" />
                <Button x:Name="ReplaceAllButton" Padding="12,5" Margin="5,0,0,0" Click="ReplaceAllButton_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
