<Window x:Class="Glystrata.Views.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compare snapshot"
        Width="980"
        Height="720"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="SelectorPanel" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
            <TextBlock x:Name="SelectorLabel" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource PrimaryTextBrush}" />
            <ComboBox x:Name="SnapshotSelector" Width="320" SelectionChanged="SnapshotSelector_SelectionChanged" />
        </StackPanel>
        <RichTextBox x:Name="DiffText"
                     Grid.Row="1"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource BorderBrush}"
                     Background="{DynamicResource SurfaceBrush}"
                     Foreground="{DynamicResource PrimaryTextBrush}"
                     FontFamily="Cascadia Mono"
                     FontSize="13"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled" />
    </Grid>
</Window>
